ARG YSE_BASE_IMAGE=ghcr.io/young-supernova-experiment/yse_pz:latest
FROM ${YSE_BASE_IMAGE}
LABEL description="YSE-PZ web dev layer (Young Supernova Experiment)"
LABEL org.opencontainers.image.source="https://github.com/Young-Supernova-Experiment/YSE_PZ"

SHELL ["/bin/bash", "-c"]

RUN apt-get update --fix-missing && \
    apt-get install -y --no-install-recommends libcurl4-openssl-dev && \
    pip install --upgrade pip

WORKDIR /app
RUN mkdir -p /app/ghost_logs

COPY requirements.web.dev /app/requirements.web.txt
RUN pip install -r /app/requirements.web.txt

RUN apt-get clean && \
rm -rf /var/lib/apt/lists/*
